# Real values are in .env
# .env is gitignored; this template is committed.

POSTGRES_USER=tracker_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=application_tracker
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://tracker_user:change_me@localhost:5432/application_tracker

# Host path where CV files live. Bind-mounted into the api container at /app/data/cvs.
# Leave unset on dev - the default is ./data/cvs inside the repo.
# On the server, uncomment and point at the SSD archive:
# CV_HOST_PATH=/mnt/RedArchive_Hot/Job_tracker/cvs